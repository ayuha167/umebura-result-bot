# Discord Developer Portal > General Information
DISCORD_APPLICATION_ID=1526627385821233163

# Discord Developer Portal > Bot > Token
# 絶対にGitへコミットしないでください。
DISCORD_BOT_TOKEN=

# ウメブラ Discord サーバー
DISCORD_GUILD_ID=356806525538402315

# start.gg > Developer Settings で発行する個人用APIトークン
STARTGG_TOKEN=

# https://www.start.gg/tournament/sp12-umeburasp12/event/singles/overview
STARTGG_EVENT_SLUG=tournament/sp12-umeburasp12/event/singles
STARTGG_TOURNAMENT_LABEL=ウメブラSP12 Singles

# 取得した全順位を保存するJSONテキスト（省略可）
STANDINGS_FILE=data/standings.json

# 順位画像の背景（1920 x 1080 px）
RESULT_BACKGROUND_FILE=assets/YourResults01.png
RESULT_IMAGES_DIR=assets/result-images
RESULT_STATIC_OVERLAY_FILE=assets/YourResults01-overlay.png

# OpenAI Platformで発行するAPIキー（ChatGPTの契約とは別課金）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# サーバーごとのask設定保存先（省略可）
BOT_SETTINGS_FILE=data/bot-settings.json
